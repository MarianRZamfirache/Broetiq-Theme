{% # theme-check-disable UndefinedObject, UnusedDocParam %}
{% doc %}
  Outputs the CSS custom property declarations for one color palette (light or dark),
  scoped to the given selector. Shared by snippets/color-palette.liquid, which renders
  this twice: once for the light (default) settings, once for the dark_-prefixed ones.

  @param {string} mode_prefix - '' for the light/default settings, 'dark_' for the dark ones.
  @param {string} selector - CSS selector to scope the output to (':root' or "html[data-color-mode='dark']").

  @example
  {% render 'palette-vars', mode_prefix: '', selector: ':root' %}
  {% render 'palette-vars', mode_prefix: 'dark_', selector: "html[data-color-mode='dark']" %}
{% enddoc %}

{% comment %}
  Liquid's settings[...] bracket lookup only accepts a plain variable/string, not a piped
  expression - so every dynamic key is computed into its own variable first (key_x), then
  looked up as settings[key_x]. theme-check's static analyzer also can't trace `assign`
  targets whose value is a dynamic bracket lookup (proven safe at runtime elsewhere in this
  theme, e.g. snippets/theme-styles-variables.liquid's `settings[size_setting]`), so it flags
  every variable assigned below as an "Unknown object" false positive wherever it's used later.
{% endcomment %}
{% liquid
  assign key_page_background_color = mode_prefix | append: 'page_background_color'
  assign page_background_color = settings[key_page_background_color]

  assign key_page_text_color = mode_prefix | append: 'page_text_color'
  assign page_text_color = settings[key_page_text_color]

  assign key_primary_button_background = mode_prefix | append: 'palette_primary_button_background'
  assign primary_button_background = settings[key_primary_button_background]

  assign key_primary_button_text = mode_prefix | append: 'palette_primary_button_text'
  assign primary_button_text = settings[key_primary_button_text]

  assign key_primary_button_border = mode_prefix | append: 'palette_primary_button_border'
  assign primary_button_border = settings[key_primary_button_border]

  assign key_secondary_button_background = mode_prefix | append: 'palette_secondary_button_background'
  assign secondary_button_background = settings[key_secondary_button_background]

  assign key_secondary_button_text = mode_prefix | append: 'palette_secondary_button_text'
  assign secondary_button_text = settings[key_secondary_button_text]

  assign key_secondary_button_border = mode_prefix | append: 'palette_secondary_button_border'
  assign secondary_button_border = settings[key_secondary_button_border]

  assign key_input_background = mode_prefix | append: 'palette_input_background'
  assign input_background = settings[key_input_background]

  assign key_input_text = mode_prefix | append: 'palette_input_text'
  assign input_text = settings[key_input_text]

  assign key_input_border = mode_prefix | append: 'palette_input_border'
  assign input_border = settings[key_input_border]

  assign key_variant_background = mode_prefix | append: 'palette_variant_background'
  assign variant_background = settings[key_variant_background]

  assign key_variant_text = mode_prefix | append: 'palette_variant_text'
  assign variant_text = settings[key_variant_text]

  assign key_variant_border = mode_prefix | append: 'palette_variant_border'
  assign variant_border = settings[key_variant_border]

  assign key_selected_variant_background = mode_prefix | append: 'palette_selected_variant_background'
  assign selected_variant_background = settings[key_selected_variant_background]

  assign key_selected_variant_text = mode_prefix | append: 'palette_selected_variant_text'
  assign selected_variant_text = settings[key_selected_variant_text]

  assign key_selected_variant_border = mode_prefix | append: 'palette_selected_variant_border'
  assign selected_variant_border = settings[key_selected_variant_border]

  assign key_drawer_shadow_color = mode_prefix | append: 'drawer_shadow_color'
  assign drawer_shadow_color = settings[key_drawer_shadow_color]

  assign key_popover_shadow_color = mode_prefix | append: 'popover_shadow_color'
  assign popover_shadow_color = settings[key_popover_shadow_color]
%}

{% comment %}
  Compute palette lightest & darkest once for smart contrast.

  The light pass has a real merchant-editable settings.color_palette array (Shopify only
  allows one "color_palette"-type setting per theme, so there's no dark_color_palette
  equivalent) - loop it like stock Horizon does. The dark pass only has the two anchor
  colors (dark_page_background_color / dark_page_text_color), so it derives the extremes
  directly from whichever of those two is brighter.
{% endcomment %}
{% liquid
  assign palette_lightest = '#ffffff'
  assign palette_lightest_brightness = -1
  assign palette_darkest = '#000000'
  assign palette_darkest_brightness = 256

  if mode_prefix == blank
    for palette_color in settings.color_palette
      if palette_color != blank and palette_color.alpha == 1
        assign b = palette_color | color_brightness
        if b > palette_lightest_brightness
          assign palette_lightest = palette_color
          assign palette_lightest_brightness = b
        endif
        if b < palette_darkest_brightness
          assign palette_darkest = palette_color
          assign palette_darkest_brightness = b
        endif
      endif
    endfor
  else
    assign bg_brightness_for_extremes = page_background_color | color_brightness
    assign fg_brightness_for_extremes = page_text_color | color_brightness
    if bg_brightness_for_extremes > fg_brightness_for_extremes
      assign palette_lightest = page_background_color
      assign palette_darkest = page_text_color
    else
      assign palette_lightest = page_text_color
      assign palette_darkest = page_background_color
    endif
  endif
%}

{% comment %} Primary button effective values {% endcomment %}
{% liquid
  if primary_button_background.alpha == 0
    assign effective_primary_button_focus_outline = primary_button_text
  else
    assign effective_primary_button_focus_outline = primary_button_background
  endif

  capture effective_primary_button_hover_background
    render 'util-palette-hover-shift', color: primary_button_background
  endcapture
  if primary_button_background.alpha == 1
    assign primary_hover_background_has_alpha = false
  else
    assign primary_hover_background_has_alpha = true
  endif

  assign primary_hover_brightness = effective_primary_button_hover_background | color_brightness
  if primary_hover_brightness > 128
    assign primary_button_hover_contrast = palette_darkest
  else
    assign primary_button_hover_contrast = palette_lightest
  endif

  if primary_hover_background_has_alpha
    assign effective_primary_button_hover_text = primary_button_text
  else
    assign effective_primary_button_hover_text = primary_button_hover_contrast
  endif

  if primary_button_border == primary_button_background
    assign effective_primary_button_hover_border = effective_primary_button_hover_background
  else
    capture effective_primary_button_hover_border
      render 'util-palette-hover-shift', color: primary_button_border
    endcapture
  endif
%}

{% comment %} Secondary button hover effective values {% endcomment %}
{% liquid
  capture effective_secondary_button_hover_background
    render 'util-palette-hover-shift', color: secondary_button_background
  endcapture
  if secondary_button_background.alpha == 1
    assign secondary_hover_background_has_alpha = false
  else
    assign secondary_hover_background_has_alpha = true
  endif

  assign secondary_hover_brightness = effective_secondary_button_hover_background | color_brightness
  if secondary_hover_brightness > 128
    assign secondary_button_hover_contrast = palette_darkest
  else
    assign secondary_button_hover_contrast = palette_lightest
  endif

  if secondary_hover_background_has_alpha
    assign effective_secondary_button_hover_text = secondary_button_text
  else
    assign effective_secondary_button_hover_text = secondary_button_hover_contrast
  endif

  if secondary_button_border == secondary_button_background
    assign effective_secondary_button_hover_border = effective_secondary_button_hover_background
  else
    capture effective_secondary_button_hover_border
      render 'util-palette-hover-shift', color: secondary_button_border
    endcapture
  endif
%}

{% comment %} Variant hover effective values (smart contrast for fallback text/border) {% endcomment %}
{% liquid
  capture effective_variant_hover_background
    render 'util-palette-hover-shift', color: variant_background
  endcapture

  if variant_background.alpha == 1
    assign variant_hover_background_has_alpha = false
  else
    assign variant_hover_background_has_alpha = true
  endif

  assign variant_hover_brightness = effective_variant_hover_background | color_brightness
  if variant_hover_brightness > 128
    assign variant_hover_contrast = palette_darkest
  else
    assign variant_hover_contrast = palette_lightest
  endif

  if variant_hover_background_has_alpha
    assign effective_variant_hover_text = variant_text
  else
    assign effective_variant_hover_text = variant_hover_contrast
  endif

  if variant_border == variant_background
    assign effective_variant_hover_border = effective_variant_hover_background
  else
    capture effective_variant_hover_border
      render 'util-palette-hover-shift', color: variant_border
    endcapture
  endif
%}
{% comment %} Selected variant hover effective values (smart contrast for fallback text/border) {% endcomment %}
{% liquid
  capture effective_selected_variant_hover_background
    render 'util-palette-hover-shift', color: selected_variant_background
  endcapture
  if selected_variant_background.alpha == 1
    assign selected_variant_hover_background_has_alpha = false
  else
    assign selected_variant_hover_background_has_alpha = true
  endif

  assign sel_variant_hover_brightness = effective_selected_variant_hover_background | color_brightness
  if sel_variant_hover_brightness > 128
    assign selected_variant_hover_contrast = palette_darkest
  else
    assign selected_variant_hover_contrast = palette_lightest
  endif

  if selected_variant_hover_background_has_alpha
    assign effective_selected_variant_hover_text = selected_variant_text
  else
    assign effective_selected_variant_hover_text = selected_variant_hover_contrast
  endif

  if selected_variant_border == selected_variant_background
    assign effective_selected_variant_hover_border = effective_selected_variant_hover_background
  else
    capture effective_selected_variant_hover_border
      render 'util-palette-hover-shift', color: selected_variant_border
    endcapture
  endif
%}

{% style %}
  /* Palette colors */
  {{ selector }} {
    --color-background: {{ page_background_color }};
    --color-background-rgb: {{ page_background_color.rgb }};
    --color-foreground: {{ page_text_color }};
    --color-foreground-rgb: {{ page_text_color.rgb }};
    --color-border: {{ page_text_color }};
    --color-border-rgb: {{ page_text_color.rgb }};
    --palette-lightest: {{ palette_lightest }};
    --palette-lightest-rgb: {{ palette_lightest.rgb }};
    --palette-darkest: {{ palette_darkest }};
    --palette-darkest-rgb: {{ palette_darkest.rgb }};
    {% render 'brightness-opacities', background: page_background_color %}

    --color-primary-button-text: rgb({{ primary_button_text.rgba }});
    --color-primary-button-background: rgb({{ primary_button_background.rgba }});
    --color-primary-button-border: rgb({{ primary_button_border.rgba }});
    --color-primary-button-focus-outline: rgb({{ effective_primary_button_focus_outline.rgb }});
    --color-primary-button-hover-text: rgb({{ effective_primary_button_hover_text.rgba }});
    --color-primary-button-hover-background: {{ effective_primary_button_hover_background }};
    --color-primary-button-hover-border: {{ effective_primary_button_hover_border }};

    --color-secondary-button-text: rgb({{ secondary_button_text.rgba }});
    --color-secondary-button-background: rgb({{ secondary_button_background.rgba }});
    --color-secondary-button-border: rgb({{ secondary_button_border.rgba }});
    --color-secondary-button-hover-text: rgb({{ effective_secondary_button_hover_text.rgba }});
    --color-secondary-button-hover-background: {{ effective_secondary_button_hover_background }};
    --color-secondary-button-hover-border: {{ effective_secondary_button_hover_border }};

    --color-input-background: rgb({{ input_background.rgba }});
    --color-input-text: rgb({{ input_text.rgba }});
    --color-input-text-rgb: {{ input_text.rgb }};
    --color-input-border: rgb({{ input_border.rgba }});

    --color-variant-background: rgb({{ variant_background.rgba }});
    --color-variant-border: rgb({{ variant_border.rgba }});
    --color-variant-text: rgb({{ variant_text.rgba }});
    --color-variant-text-rgb: {{ variant_text.rgb }};
    --color-variant-hover-background: {{ effective_variant_hover_background }};
    --color-variant-hover-text: rgb({{ effective_variant_hover_text.rgba }});
    --color-variant-hover-border: {{ effective_variant_hover_border }};

    --color-selected-variant-background: rgb({{ selected_variant_background.rgba }});
    --color-selected-variant-border: rgb({{ selected_variant_border.rgba }});
    --color-selected-variant-text: rgb({{ selected_variant_text.rgba }});
    --color-selected-variant-text-rgb: {{ selected_variant_text.rgb }};
    --color-selected-variant-hover-background: {{ effective_selected_variant_hover_background }};
    --color-selected-variant-hover-text: rgb({{ effective_selected_variant_hover_text.rgba }});
    --color-selected-variant-hover-border: {{ effective_selected_variant_hover_border }};

    --input-disabled-background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    --input-disabled-border-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
    --input-disabled-text-color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    --color-foreground-muted: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-muted-text));
    --color-foreground-subdued: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
    --color-drawer-shadow-rgb: {{ drawer_shadow_color.rgb }};
    --color-popover-shadow-rgb: {{ popover_shadow_color.rgb }};

    /* Shadows */
    {% if settings.drawer_drop_shadow %}
      --shadow-drawer: 0px 4px 20px rgb(var(--color-drawer-shadow-rgb) / var(--opacity-15));
    {% endif %}
    {% if settings.popover_drop_shadow %}
      --shadow-blur: 20px;
      --shadow-popover: 0px 4px 20px rgb(var(--color-popover-shadow-rgb) / var(--opacity-15));
    {% endif %}
  }
{% endstyle %}
{% # theme-check-enable UndefinedObject, UnusedDocParam %}
