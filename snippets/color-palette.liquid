{% doc %}
  Outputs CSS custom property declarations for the color palette defined in theme settings.

  Renders snippets/palette-vars.liquid once for the light (default) settings, and again for
  the dark_-prefixed settings when dark mode is enabled - the second pass is scoped to
  html[data-color-mode='dark'], so it only takes effect once assets/color-mode-init.js (via
  snippets/color-mode-init.liquid) sets that attribute on <html>.
{% enddoc %}

{% render 'palette-vars', mode_prefix: '', selector: ':root' %}

{% if settings.enable_dark_mode %}
  {% render 'palette-vars', mode_prefix: 'dark_', selector: "html[data-color-mode='dark']" %}
{% endif %}

{% style %}
  body {
    color: var(--color-foreground);
    background-color: var(--color-background);
  }
{% endstyle %}
