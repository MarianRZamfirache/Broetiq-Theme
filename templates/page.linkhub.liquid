{% layout none %}
<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BROETIQ — Conectează-te cu noi</title>
<meta name="description" content="BROETIQ — atelier premium de print UV, București. Instagram, Facebook, shop și prezentarea noastră, toate într-un singur loc.">
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quantico:wght@400;700&family=Barlow+Condensed:wght@500;600&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0E0E10;
    --panel:#17171A;
    --line:#2A2A2E;
    --orange:#F05A28;
    --orange-hot:#F26430;
    --paper:#F4F2EE;
    --muted:#9A9AA0;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%}
  body{
    background:var(--ink);
    color:var(--paper);
    font-family:'DM Sans',sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:32px 20px;
    -webkit-font-smoothing:antialiased;
  }
  /* textura discreta de "masa de productie" */
  body::before{
    content:"";
    position:fixed;inset:0;
    background-image:radial-gradient(var(--line) 1px, transparent 1px);
    background-size:26px 26px;
    opacity:.25;
    pointer-events:none;
  }
  .hub{
    width:100%;
    max-width:440px;
    position:relative;
    z-index:1;
  }
  /* header */
  .brand{
    text-align:center;
    margin-bottom:8px;
  }
  .brand h1{
    font-family:'Quantico',sans-serif;
    font-weight:700;
    font-size:clamp(34px,9vw,44px);
    letter-spacing:.14em;
    text-transform:uppercase;
  }
  .brand h1 span{color:var(--orange)}
  .brand .tag{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:500;
    font-size:15px;
    letter-spacing:.32em;
    text-transform:uppercase;
    color:var(--muted);
    margin-top:6px;
  }
  /* linie de "registru de print" sub brand */
  .reg{
    display:flex;
    align-items:center;
    gap:10px;
    margin:22px 0 28px;
  }
  .reg::before,.reg::after{
    content:"";
    flex:1;
    height:1px;
    background:var(--line);
  }
  .reg .marks{
    display:flex;
    gap:6px;
  }
  .reg .marks i{
    width:8px;height:8px;
    border:1px solid var(--muted);
    display:block;
  }
  .reg .marks i:nth-child(2){background:var(--orange);border-color:var(--orange)}
  /* butoane = mostre de material */
  .links{display:flex;flex-direction:column;gap:14px}
  .swatch{
    position:relative;
    display:flex;
    align-items:center;
    gap:16px;
    background:var(--panel);
    border:1px solid var(--line);
    padding:18px 20px;
    text-decoration:none;
    color:var(--paper);
    transition:border-color .18s ease, transform .18s ease;
  }
  .swatch:hover,.swatch:focus-visible{
    border-color:var(--orange);
    transform:translateX(4px);
    outline:none;
  }
  .swatch:focus-visible{box-shadow:0 0 0 2px var(--orange)}
  /* crop marks pe colturi */
  .swatch::before,.swatch::after{
    content:"";
    position:absolute;
    width:10px;height:10px;
    border-color:var(--orange);
    border-style:solid;
    opacity:0;
    transition:opacity .18s ease;
  }
  .swatch::before{top:-1px;left:-1px;border-width:2px 0 0 2px}
  .swatch::after{bottom:-1px;right:-1px;border-width:0 2px 2px 0}
  .swatch:hover::before,.swatch:hover::after,
  .swatch:focus-visible::before,.swatch:focus-visible::after{opacity:1}
  .swatch .icon{
    flex:0 0 auto;
    width:40px;height:40px;
    display:grid;
    place-items:center;
    background:var(--ink);
    border:1px solid var(--line);
  }
  .swatch .icon svg{width:20px;height:20px;fill:var(--orange)}
  .swatch .txt{display:flex;flex-direction:column;gap:2px}
  .swatch .txt b{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:600;
    font-size:19px;
    letter-spacing:.12em;
    text-transform:uppercase;
  }
  .swatch .txt small{
    font-size:13px;
    color:var(--muted);
  }
  .swatch .go{
    margin-left:auto;
    font-family:'Quantico',sans-serif;
    color:var(--orange);
    font-size:18px;
  }
  footer{
    margin-top:32px;
    text-align:center;
    font-size:12px;
    color:var(--muted);
    letter-spacing:.08em;
  }
  footer a{color:var(--muted)}
  @media (prefers-reduced-motion: reduce){
    .swatch,.swatch::before,.swatch::after{transition:none}
    .swatch:hover{transform:none}
  }
</style>
</head>
<body>
<main class="hub">
  <header class="brand">
    <h1>BROETI<span>Q</span></h1>
    <p class="tag">UV Print Atelier · București</p>
  </header>

  <div class="reg" aria-hidden="true">
    <span class="marks"><i></i><i></i><i></i></span>
  </div>

  <nav class="links" aria-label="Linkuri BROETIQ">

    <a class="swatch" href="https://www.instagram.com/broetiq/" target="_blank" rel="noopener">
      <span class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.8.07 1.2.05 1.8.24 2.2.4.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.16.4.35 1 .4 2.2.07 1.2.07 1.6.07 4.8s0 3.6-.07 4.8c-.05 1.2-.24 1.8-.4 2.2-.22.6-.48 1-.9 1.4-.4.4-.8.7-1.4.9-.4.16-1 .35-2.2.4-1.2.07-1.6.07-4.8.07s-3.6 0-4.8-.07c-1.2-.05-1.8-.24-2.2-.4-.6-.22-1-.48-1.4-.9-.4-.4-.7-.8-.9-1.4-.16-.4-.35-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.8c.05-1.2.24-1.8.4-2.2.22-.6.48-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.16 1-.35 2.2-.4C8.4 2.2 8.8 2.2 12 2.2m0 3.6a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4m0 10.2a4 4 0 1 1 0-8 4 4 0 0 1 0 8m6.4-10.4a1.45 1.45 0 1 1-2.9 0 1.45 1.45 0 0 1 2.9 0"/></svg>
      </span>
      <span class="txt"><b>Instagram</b><small>Portofoliu, proiecte, behind the scenes</small></span>
      <span class="go" aria-hidden="true">→</span>
    </a>

    <a class="swatch" href="https://www.facebook.com/profile.php?id=61574363936682" target="_blank" rel="noopener">
      <span class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12"/></svg>
      </span>
      <span class="txt"><b>Facebook</b><small>Noutăți și comunitate</small></span>
      <span class="go" aria-hidden="true">→</span>
    </a>

    <a class="swatch" href="https://broetiq.ro" target="_blank" rel="noopener">
      <span class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m6.9 6h-3a15.6 15.6 0 0 0-1.4-3.7A8 8 0 0 1 18.9 8M12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4M4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.6 16.6 0 0 0 0 4zm.8 2h3a15.6 15.6 0 0 0 1.4 3.7A8 8 0 0 1 5.1 16m3-8h-3a8 8 0 0 1 4.4-3.7A15.6 15.6 0 0 0 8.1 8M12 20c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4m2.3-6H9.7a14.6 14.6 0 0 1 0-4h4.6a14.6 14.6 0 0 1 0 4m.2 5.7A15.6 15.6 0 0 0 15.9 16h3a8 8 0 0 1-4.4 3.7M16.3 14a16.6 16.6 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4z"/></svg>
      </span>
      <span class="txt"><b>Site &amp; Shop</b><small>broetiq.ro — stickere, etichete, canvas, UV print</small></span>
      <span class="go" aria-hidden="true">→</span>
    </a>

    <a class="swatch" href="/prezentare" target="_blank" rel="noopener">
      <span class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm4 18H6V4h7v5h5zM12 18l-4-4h2.5v-3h3v3H16z"/></svg>
      </span>
      <span class="txt"><b>Prezentare PDF</b><small>Cine suntem și ce producem — un singur document</small></span>
      <span class="go" aria-hidden="true">→</span>
    </a>

  </nav>

  <footer>
    BROETIQ SRL · Atelier print UV · <a href="mailto:contact@broetiq.ro">contact@broetiq.ro</a>
  </footer>
</main>
</body>
</html>
